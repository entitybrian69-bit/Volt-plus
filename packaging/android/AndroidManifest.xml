<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- The screen recorder: a mediaProjection capture keeps running in a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Discord Rich Presence: the Discord app publishes cards through a bound service, and
         Android 11 and later only let the app see a package it declares here. -->
    <queries>
        <package android:name="com.discord" />
        <package android:name="com.discord.beta" />
        <package android:name="com.discord.alpha" />
        <package android:name="com.discord.canary" />
        <intent>
            <action android:name="com.discord.socialsdk.rpc.IDiscordRpcService" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <application android:label="Volt Plus" android:appCategory="game" android:icon="@drawable/launcher_icon" android:banner="@drawable/tv_banner" android:allowBackup="false" android:extractNativeLibs="true" android:usesCleartextTraffic="false">
        <provider android:name="dev.horizon.android.HorizonDocumentsProvider" android:authorities="${applicationId}.documents" android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- Records the screen from the game's own overlay (see RecorderService). -->
        <service android:name="dev.horizon.android.RecorderService" android:exported="false" android:foregroundServiceType="mediaProjection" android:stopWithTask="true" />
        <activity android:name="dev.horizon.android.HorizonActivity" android:exported="false" android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden|keyboard|density|screenLayout" android:windowSoftInputMode="adjustResize" android:theme="@style/HorizonGameTheme">
            <meta-data android:name="android.app.lib_name" android:value="horizon_android" />
            <meta-data android:name="android.app.func_name" android:value="horizon_on_create" />
        </activity>
        <!-- The video needs its own regular window: NativeActivity takes over its window surface. -->
        <activity android:name="dev.horizon.android.IntroActivity" android:exported="false" android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|keyboardHidden|keyboard|density|screenLayout" android:theme="@style/HorizonGameTheme" />
        <!-- Keep installed launcher shortcuts targeting the previous component. -->
        <activity-alias android:name="com.google.androidgamesdk.GameActivity" android:targetActivity="dev.horizon.android.IntroActivity" android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="horizon_android" />
            <meta-data android:name="android.app.func_name" android:value="horizon_on_create" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
